<!-- ==================== JAVASCRIPT ==================== -->
<script>
function openModal(id) { document.getElementById(id).classList.remove('hidden'); document.body.classList.add('overflow-hidden'); }
function closePopup(id) { document.getElementById(id).classList.add('hidden'); document.body.classList.remove('overflow-hidden'); }
function requireAuth() { openModal('popup-auth'); }

// Tab switcher cho xác thực (3 tab: login / register / forgot / reset)
function showAuthTab(tab) {
    const tabs = ['login', 'register', 'forgot', 'reset'];
    tabs.forEach(t => {
        const panel = document.getElementById('panel-' + t);
        const btn   = document.getElementById('btn-' + t + '-tab');
        if (!panel) return;
        panel.classList.toggle('hidden', t !== tab);
        if (btn) {
            btn.className = (t === tab)
                ? 'flex-1 py-2 text-xs font-bold text-brand-600 border-b-2 border-brand-600'
                : 'flex-1 py-2 text-xs font-semibold text-gray-400 border-b-2 border-transparent hover:text-brand-500 transition-colors';
        }
    });
}

function switchTab(showId, hideId) {
    document.getElementById(showId).classList.remove('hidden');
    document.getElementById(hideId).classList.add('hidden');
}

// Close modal on background click
['modal-bookings', 'modal-rooms', 'popup-auth'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.addEventListener('click', function(e) { if (e.target === this) closePopup(id); });
});

// AJAX: Đặt lịch họp
const formBooking = document.getElementById('form-create-booking');
if (formBooking) {
    formBooking.addEventListener('submit', async function(e) {
        e.preventDefault();
        const fd = new FormData(this);
        const btn = this.querySelector('button[type=submit]');
        btn.disabled = true; btn.textContent = 'Đang xử lý...';
        try {
            const res = await fetch('/Home/CreateBooking', { method: 'POST', body: fd });
            const data = await res.json();
            const el = document.getElementById('booking-success');
            if (data.conflict) {
                // Hiện thông báo trùng lịch màu đỏ nổi bật
                el.innerHTML = '❌ <strong>Trùng lịch, đã có lịch đăng ký!</strong> Vui lòng chọn thời gian khác hoặc phòng khác.';
                el.className = 'mb-4 p-4 bg-red-50 border-2 border-red-400 rounded-xl text-red-700 text-sm font-bold animate-pulse';
            } else {
                el.textContent = data.success ? '✅ ' + data.message : '❌ ' + data.message;
                el.className = data.success
                    ? 'mb-4 p-3 bg-green-50 border border-green-200 rounded-lg text-green-700 text-sm font-semibold'
                    : 'mb-4 p-3 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm font-semibold';
            }
            el.classList.remove('hidden');
            if (data.success) { formBooking.reset(); setTimeout(() => location.reload(), 1500); }
        } catch(err) {
            const el = document.getElementById('booking-success');
            el.textContent = '❌ Lỗi kết nối. Vui lòng thử lại.';
            el.className = 'mb-4 p-3 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm font-semibold';
            el.classList.remove('hidden');
        } finally { btn.disabled = false; btn.textContent = 'Chốt lịch họp 🚀'; }
    });
}

// AJAX: Thêm phòng họp
const formRoom = document.getElementById('form-create-room');
if (formRoom) {
    formRoom.addEventListener('submit', async function(e) {
        e.preventDefault();
        const fd = new FormData(this);
        const btn = this.querySelector('button[type=submit]');
        btn.disabled = true; btn.textContent = 'Đang lưu...';
        try {
            const res = await fetch('/Home/CreateRoom', { method: 'POST', body: fd });
            const data = await res.json();
            const el = document.getElementById('room-success');
            el.textContent = data.success ? '✅ ' + data.message : '❌ ' + data.message;
            el.className = data.success
                ? 'mb-4 p-3 bg-green-50 border border-green-200 rounded-lg text-green-700 text-sm font-semibold'
                : 'mb-4 p-3 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm font-semibold';
            el.classList.remove('hidden');
            if (data.success) { formRoom.reset(); setTimeout(() => location.reload(), 1500); }
        } catch { } finally { btn.disabled = false; btn.textContent = 'Tạo phòng mới 🏢'; }
    });
}

// Tự động mở đúng tab khi có cần (TempData chỉ định)
document.addEventListener('DOMContentLoaded', () => {
    const initTab = '@initTab';
    if (initTab && initTab !== 'login') showAuthTab(initTab);
});

// ─── Admin: Mở modal duyệt ───────────────────────────────────────────────────
function openApproveModal(id, title) {
    document.getElementById('approve-booking-id').value = id;
    document.getElementById('approve-booking-title').textContent = title;
    openModal('modal-approve-booking');
}
async function submitApprove() {
    const id    = document.getElementById('approve-booking-id').value;
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    const fd = new FormData(); fd.append('id', id); fd.append('__RequestVerificationToken', token);
    const btn = document.querySelector('#modal-approve-booking button:last-child');
    btn.disabled = true; btn.textContent = 'Đang xử lý...';
    const res  = await fetch('/Home/ApproveBooking', { method: 'POST', body: fd });
    const data = await res.json();
    closePopup('modal-approve-booking');
    btn.disabled = false; btn.innerHTML = '✅ Đồng ý duyệt';
    if (data.success) location.reload();
    else alert(data.message);
}

// ─── Admin: Mở modal từ chối ─────────────────────────────────────────────────
function openRejectModal(id) {
    document.getElementById('reject-booking-id').value = id;
    document.getElementById('reject-reason').value = '';
    openModal('modal-reject-booking');
}
async function submitReject() {
    const id     = document.getElementById('reject-booking-id').value;
    const reason = document.getElementById('reject-reason').value.trim();
    if (!reason) { alert('Vui lòng nhập lý do từ chối.'); return; }
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    const fd = new FormData();
    fd.append('id', id); fd.append('reason', reason); fd.append('__RequestVerificationToken', token);
    const btn = document.querySelector('#modal-reject-booking button:last-child');
    btn.disabled = true; btn.textContent = 'Đang xử lý...';
    const res  = await fetch('/Home/RejectBooking', { method: 'POST', body: fd });
    const data = await res.json();
    closePopup('modal-reject-booking');
    btn.disabled = false; btn.textContent = 'Xác nhận từ chối';
    if (data.success) location.reload();
    else alert(data.message);
}

// ─── Mở modal Sửa lịch (via data-* attributes, event delegation) ─────────────
document.addEventListener('click', function(e) {
    const btn = e.target.closest('.btn-edit');
    if (!btn) return;
    document.getElementById('edit-booking-id').value  = btn.dataset.id;
    document.getElementById('edit-roomId').value      = btn.dataset.roomid;
    document.getElementById('edit-title').value       = btn.dataset.title;
    document.getElementById('edit-startTime').value   = btn.dataset.start;
    document.getElementById('edit-endTime').value     = btn.dataset.end;
    document.getElementById('edit-description').value = btn.dataset.desc;
    document.getElementById('edit-booking-msg').classList.add('hidden');
    openModal('modal-edit-booking');
});

// ─── AJAX: Submit sửa lịch ───────────────────────────────────────────────────
const formEdit = document.getElementById('form-edit-booking');
if (formEdit) {
    formEdit.addEventListener('submit', async function(e) {
        e.preventDefault();
        const fd  = new FormData(this);
        const btn = this.querySelector('button[type=submit]');
        btn.disabled = true; btn.textContent = 'Đang lưu...';
        try {
            const res  = await fetch('/Home/EditBooking', { method: 'POST', body: fd });
            const data = await res.json();
            const msg  = document.getElementById('edit-booking-msg');
            if (data.conflict) {
                msg.textContent = '❌ Trùng lịch, đã có lịch đăng ký! Vui lòng chọn thời gian khác.';
                msg.className   = 'mb-3 p-3 rounded-lg text-sm font-bold bg-red-50 border-2 border-red-400 text-red-700';
                msg.classList.remove('hidden');
            } else {
                msg.textContent = (data.success ? '✅ ' : '❌ ') + data.message;
                msg.className   = 'mb-3 p-3 rounded-lg text-sm font-semibold ' + (data.success ? 'bg-green-50 text-green-700' : 'bg-red-50 text-red-700');
                msg.classList.remove('hidden');
                if (data.success) setTimeout(() => { closePopup('modal-edit-booking'); location.reload(); }, 1000);
            }
        } finally { btn.disabled = false; btn.textContent = 'Lưu thay đổi 💾'; }
    });
}

// ─── Mở modal xoá lịch ───────────────────────────────────────────────────────
function openDeleteModal(id, title) {
    document.getElementById('delete-booking-id').value = id;
    document.getElementById('delete-booking-title').textContent = title;
    openModal('modal-delete-booking');
}
async function submitDelete() {
    const id    = document.getElementById('delete-booking-id').value;
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    const fd = new FormData(); fd.append('id', id); fd.append('__RequestVerificationToken', token);
    const btn = document.querySelector('#modal-delete-booking button:last-child');
    btn.disabled = true; btn.textContent = 'Đang xoá...';
    const res  = await fetch('/Home/DeleteBooking', { method: 'POST', body: fd });
    const data = await res.json();
    closePopup('modal-delete-booking');
    btn.disabled = false; btn.innerHTML = '🗑️ Xoá lịch';
    if (data.success) location.reload();
    else alert(data.message);
}

// ─── Dark / Light Mode ────────────────────────────────────────────────────────
function applyTheme(isDark) {
    const html = document.documentElement;
    if (isDark) {
        html.setAttribute('data-theme', 'dark');
    } else {
        html.removeAttribute('data-theme');
    }
    const icon  = document.getElementById('theme-icon');
    const label = document.getElementById('theme-label');
    const track = document.getElementById('theme-track');
    const thumb = document.getElementById('theme-thumb');
    if (icon)  icon.textContent  = isDark ? '☀️' : '🌙';
    if (label) label.textContent = isDark ? 'Giao diện sáng' : 'Giao diện tối';
    if (track) { track.style.backgroundColor = isDark ? '#3b82f6' : ''; }
    if (thumb) { thumb.style.transform = isDark ? 'translateX(1.25rem)' : 'translateX(0.25rem)'; }
}
function toggleTheme() {
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    const next = !isDark;
    localStorage.setItem('theme', next ? 'dark' : 'light');
    applyTheme(next);
}
// Apply saved theme immediately on load
(function() {
    const saved = localStorage.getItem('theme');
    applyTheme(saved === 'dark');
})();

// ─── User Management (Admin only) ─────────────────────────────────────────────
async function changeRole(userId) {
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    const res = await fetch('/Home/ChangeRole', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: `userId=${encodeURIComponent(userId)}&__RequestVerificationToken=${encodeURIComponent(token)}`
    });
    const data = await res.json();
    if (data.success) {
        const badge = document.getElementById('role-badge-' + userId);
        if (badge) {
            if (data.newRole === 'Admin') {
                badge.textContent = '👑 Admin';
                badge.className = 'inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-purple-100 text-purple-700';
            } else {
                badge.textContent = '👤 Employee';
                badge.className = 'inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-gray-100 text-gray-600';
            }
        }
    } else {
        alert(data.message);
    }
}

let _deleteUserId = null;
function openDeleteUser(userId, userName) {
    _deleteUserId = userId;
    document.getElementById('delete-user-name').textContent = userName;
    document.getElementById('modal-delete-user').classList.remove('hidden');
}
document.getElementById('btn-confirm-delete-user')?.addEventListener('click', async function() {
    if (!_deleteUserId) return;
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    const res = await fetch('/Home/DeleteUser', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: `userId=${encodeURIComponent(_deleteUserId)}&__RequestVerificationToken=${encodeURIComponent(token)}`
    });
    const data = await res.json();
    if (data.success) {
        document.getElementById('user-row-' + _deleteUserId)?.remove();
        closePopup('modal-delete-user');
        _deleteUserId = null;
    } else {
        alert(data.message);
    }
});

// ─── Sửa Phòng Họp ───────────────────────────────────────────────────────────
function openEditRoom(btn) {
    document.getElementById('edit-room-id').value        = btn.dataset.id;
    document.getElementById('edit-room-name').value      = btn.dataset.name;
    document.getElementById('edit-room-capacity').value  = btn.dataset.capacity;
    document.getElementById('edit-room-equipment').value = btn.dataset.equipment;
    document.getElementById('edit-room-active').checked  = btn.dataset.isactive === 'true';
    document.getElementById('edit-room-subtitle').textContent = 'Đang sửa: ' + btn.dataset.name;
    document.getElementById('edit-room-msg').classList.add('hidden');
    openModal('modal-edit-room');
}

const formEditRoom = document.getElementById('form-edit-room');
if (formEditRoom) {
    formEditRoom.addEventListener('submit', async function(e) {
        e.preventDefault();
        const fd  = new FormData(this);
        // Ensure isActive is included even when unchecked
        if (!this.querySelector('#edit-room-active').checked) fd.set('isActive', 'false');
        const btn = document.getElementById('btn-submit-edit-room');
        btn.disabled = true; btn.textContent = 'Đang lưu...';
        try {
            const res  = await fetch('/Home/UpdateRoom', { method: 'POST', body: fd });
            const data = await res.json();
            if (data.success) {
                // Update the edit button data-* attributes so next open shows fresh data
                const editBtn = document.querySelector(`[data-id="${data.id}"][onclick*="openEditRoom"]`);
                if (editBtn) {
                    editBtn.dataset.name      = data.name;
                    editBtn.dataset.capacity  = data.capacity;
                    editBtn.dataset.equipment = data.equipment;
                    editBtn.dataset.isactive  = data.isActive ? 'true' : 'false';
                }
                closePopup('modal-edit-room');
                location.reload(); // Reload to refresh room list row visually
            } else {
                const msg = document.getElementById('edit-room-msg');
                msg.textContent = data.message;
                msg.classList.remove('hidden');
            }
        } catch { 
            alert('Lỗi kết nối, vui lòng thử lại.'); 
        } finally { 
            btn.disabled = false; btn.textContent = 'Lưu thay đổi ✓'; 
        }
    });
}

</script>
