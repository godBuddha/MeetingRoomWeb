<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản lý phòng họp</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <!-- Tailwind CSS CDN - supports all classes -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50:  '#eff6ff',
                            100: '#dbeafe',
                            200: '#bfdbfe',
                            300: '#93c5fd',
                            400: '#60a5fa',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                            800: '#1e40af',
                            900: '#1e3a8a',
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'ui-sans-serif', 'system-ui'],
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Inter', sans-serif; transition: background-color 0.3s, color 0.3s; }
        .line-clamp-2 {
            overflow: hidden;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
        }
        /* ── Dark Mode ────────────────────────────────────────── */
        [data-theme="dark"] { color-scheme: dark; }
        [data-theme="dark"] body { background-color: #0f172a !important; color: #e2e8f0 !important; }
        [data-theme="dark"] aside { background: linear-gradient(180deg,#1e293b 0%,#0f172a 100%) !important; border-color:#334155 !important; }
        [data-theme="dark"] aside .bg-white\/50,
        [data-theme="dark"] aside .bg-blue-50 { background:rgba(51,65,85,0.7) !important; border-color:#334155 !important; }
        [data-theme="dark"] main { background: linear-gradient(135deg,#1e293b 0%,#0f172a 60%,#1e293b 100%) !important; }
        [data-theme="dark"] .bg-white\/90,
        [data-theme="dark"] .bg-white\/50,
        [data-theme="dark"] .bg-white\/30 { background-color:rgba(30,41,59,0.95) !important; border-color:#334155 !important; color:#e2e8f0 !important; }
        [data-theme="dark"] .bg-white { background-color:#1e293b !important; border-color:#334155 !important; color:#e2e8f0 !important; }
        [data-theme="dark"] .text-gray-900,[data-theme="dark"] .text-gray-800 { color:#f1f5f9 !important; }
        [data-theme="dark"] .text-gray-700 { color:#cbd5e1 !important; }
        [data-theme="dark"] .text-gray-600 { color:#94a3b8 !important; }
        [data-theme="dark"] .text-gray-500 { color:#64748b !important; }
        [data-theme="dark"] .text-gray-400 { color:#475569 !important; }
        [data-theme="dark"] .border-gray-100,[data-theme="dark"] .border-gray-200,[data-theme="dark"] .border-white { border-color:#334155 !important; }
        [data-theme="dark"] .border-b,[data-theme="dark"] .border-t { border-color:#334155 !important; }
        [data-theme="dark"] .rounded-2xl.bg-white,[data-theme="dark"] .rounded-2xl.shadow-2xl,[data-theme="dark"] .rounded-2xl.shadow-xl { background-color:#1e293b !important; border:1px solid #334155; color:#e2e8f0 !important; }
        [data-theme="dark"] input[type="text"],[data-theme="dark"] input[type="email"],[data-theme="dark"] input[type="password"],
        [data-theme="dark"] input[type="datetime-local"],[data-theme="dark"] input[type="date"],[data-theme="dark"] select,[data-theme="dark"] textarea {
            background-color:#0f172a !important; border-color:#334155 !important; color:#e2e8f0 !important;
        }
        [data-theme="dark"] input::placeholder,[data-theme="dark"] textarea::placeholder { color:#475569 !important; }
        [data-theme="dark"] table thead { background-color:#1e293b !important; }
        [data-theme="dark"] table tbody tr:hover { background-color:rgba(30,41,59,0.8) !important; }
        [data-theme="dark"] table th,[data-theme="dark"] table td { border-color:#334155 !important; color:#cbd5e1 !important; }
        [data-theme="dark"] .bg-gray-50 { background-color:#0f172a !important; }
        [data-theme="dark"] .bg-gray-100 { background-color:#1e293b !important; color:#94a3b8 !important; }
        [data-theme="dark"] .hover\:bg-gray-50:hover { background-color:rgba(255,255,255,0.05) !important; }
        [data-theme="dark"] .hover\:bg-gray-100:hover { background-color:rgba(255,255,255,0.08) !important; }
        [data-theme="dark"] .min-h-screen { background-color:#0f172a !important; }
        /* Toggle track animation */
        #theme-track { transition: background-color 0.25s; }
        #theme-thumb { transition: transform 0.25s; }
    </style>
    <!-- Apply saved theme early to prevent flash -->
    <script>
        (function(){
            if(localStorage.getItem('theme')==='dark'){
                document.documentElement.setAttribute('data-theme','dark');
            }
        })();
    </script>
</head>
<body class="bg-gray-50 min-h-screen text-gray-800 antialiased">
    @RenderBody()

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
